if __name__ == "__main__":
    # 1. Автоматические тест-кейсы (оставлены для наглядности)
    balanced_examples = [
        "(((([{}]))))",
        "[([])((([[[]]])))]{()}",
        "{{[()]}}"
    ]
    
    unbalanced_examples = [
        "}{}",
        "{{[(])]}}",
        "[[{())}]"
    ]
    
    print("--- Проверка встроенных сбалансированных строк ---")
    for s in balanced_examples:
        print(f"{s}: {check_balance(s)}")
        
    print("\n--- Проверка встроенных несбалансированных строк ---")
    for s in unbalanced_examples:
        print(f"{s}: {check_balance(s)}")
        
    # 2. ДОРАБОТКА: Ввод строки из внешнего источника (консоли)
    print("\n--- Проверка вашей последовательности ---")
    user_input = input("Введите строку со скобками для проверки: ")
    result = check_balance(user_input)
    print(f"Результат проверки: {result}")

