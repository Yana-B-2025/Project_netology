# ==========================================
# ПОДКЛЮЧЕНИЕ К POSTGRESQL
# ==========================================
def get_db_connection():
    """Создает подключение к серверу PostgreSQL."""
    return psycopg2.connect(
        dbname="english_cards",
        user="postgres",
        password=DB_PASSWORD,  # ИСПРАВЛЕНО ПО PEP8: Убран пробел после '='
        host="localhost",
        port="5432"
    )


# 1. ИНИЦИАЛИЗАЦИЯ БАЗЫ ДАННЫХ И ДАННЫХ ПО УМОЛЧАНИЮ
def init_db():
    """Инициализирует БД. Создает 3 таблицы для выполнения критериев."""
    conn = get_db_connection()
    cursor = conn.cursor()

    # ТАБЛИЦА 1: Пользователи (Выполняет условие "Не менее 3-х таблиц")
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id TEXT PRIMARY KEY,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    # ТАБЛИЦА 2: Слова
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS words (
            id SERIAL PRIMARY KEY,
            user_id TEXT NOT NULL,
            russian TEXT NOT NULL,
            english TEXT NOT NULL,
            deleted_by TEXT DEFAULT ''
        )
    """)
    
    # ТАБЛИЦА 3: Статистика обучения
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS learning_stats (
            user_id TEXT PRIMARY KEY,
            cards_reviewed INT DEFAULT 0,
            correct_answers INT DEFAULT 0
        )
    """)
    conn.commit()
    
    cursor.execute(
        "SELECT COUNT(*) FROM words WHERE user_id = %s",
        ('common',)
    )
    if cursor.fetchone()[0] == 0:
        # ИСПРАВЛЕНО ПО PEP8: Длинный список разбит на строки
        default_words = [
            ("красный", "red"), ("синий", "blue"), ("зеленый", "green"),
            ("я", "i"), ("он", "he"), ("она", "she"),
            ("собака", "dog"), ("кошка", "cat"),
            ("яблоко", "apple"), ("книга", "book")
        ]
    
        for text_ru, text_en in default_words:
            cursor.execute(
                """INSERT INTO words (user_id, russian, english) 
                   VALUES ('common', %s, %s)""", 
                (text_ru, text_en)
            )
        conn.commit()
    cursor.close()
    conn.close()


# 2. ФУНКЦИИ ДЛЯ РАБОТЫ С ДАННЫМИ
def add_user_to_db(user_id):
    """Регистрирует нового пользователя в таблице users, если его там нет."""
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO users (user_id) VALUES (%s) ON CONFLICT DO NOTHING",
        (user_id,)
    )
    conn.commit()
    cursor.close()
    conn.close()


def get_user_words(user_id):
    """Получает доступные для пользователя слова."""
    conn = get_db_connection()
    cursor = conn.cursor()
    
    cursor.execute("""
        SELECT id, russian, english FROM words 
        WHERE (user_id = 'common' AND NOT deleted_by LIKE %s)
           OR (user_id = %s)
    """, (f"%|{user_id}|%", user_id))
    
    words = cursor.fetchall()
    cursor.close()
    conn.close()
    return words


def add_custom_word(user_id, russian, english):
    """Добавляет новое слово персонально для пользователя."""
    # Гарантируем, что пользователь существует в нашей новой таблице users
    add_user_to_db(user_id)

    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO words (user_id, russian, english) VALUES (%s, %s, %s)", 
        (user_id, russian.strip().lower(), english.strip().lower())
    )
    conn.commit()
    
    cursor.execute(
        "SELECT COUNT(*) FROM words WHERE user_id = %s OR user_id = 'common'",
        (user_id,)
    )
    total_count = cursor.fetchone()[0]
    
    cursor.close()
    conn.close()
    return total_count


def delete_user_word(user_id, word_id):
    """Персональное удаление слова для пользователя."""
    conn = get_db_connection()
    cursor = conn.cursor()
    
    cursor.execute(
        "SELECT user_id, deleted_by FROM words WHERE id = %s",
        (word_id,)
    )
    res = cursor.fetchone()
    
    if res is not None:
        owner = res[0]       
        deleted_by = res[1]  
        
        if owner == "common":
            if deleted_by == "":
                new_deleted_by = f"|{user_id}|"
            else:
                new_deleted_by = f"{deleted_by}{user_id}|"
            
            cursor.execute(
                "UPDATE words SET deleted_by = %s WHERE id = %s",
                (new_deleted_by, word_id)
            )
            
        elif owner == user_id:
            cursor.execute("DELETE FROM words WHERE id = %s", (word_id,))
            
    conn.commit()
    cursor.close()
    conn.close()


def get_all_english_distractors(correct_answer):
    """Собирает случайные варианты ответа для кнопок."""
    conn = get_db_connection()
    cursor = conn.cursor()

    cursor.execute(
        "SELECT DISTINCT english FROM words WHERE english != %s",
        (correct_answer,),
    )
    rows = cursor.fetchall()  
    cursor.close()
    conn.close()

    all_variants = [row[0] for row in rows]

    # ИСПРАВЛЕНО: Оптимизирована генерация заглушек, если слов мало
    while len(all_variants) < 3:
        all_variants.append(f"variant_{random.randint(1, 100)}")

    # ИСПРАВЛЕНО: Чистый Python-way выбор трёх случайных неправильных ответов
    options = random.sample(all_variants, 3)
    options.append(correct_answer)
    random.shuffle(options)

    return options


def track_review(user_id, is_correct):
    """Обновляет статистику пользователя в базе данных."""
    add_user_to_db(user_id)  # Защита от ошибок внешних ключей
    
    conn = get_db_connection()
    cursor = conn.cursor()
    
    cursor.execute(
        "SELECT COUNT(*) FROM learning_stats WHERE user_id = %s",
        (user_id,)
    )
    if cursor.fetchone()[0] == 0:
        cursor.execute(
            """INSERT INTO learning_stats (user_id, cards_reviewed, correct_answers) 
               VALUES (%s, 0, 0)""",
            (user_id,)
        )
    
    reviewed_inc = 1
    correct_inc = 1 if is_correct else 0
    cursor.execute("""
        UPDATE learning_stats 
        SET cards_reviewed = cards_reviewed + %s, 
            correct_answers = correct_answers + %s 
        WHERE user_id = %s
    """, (reviewed_inc, correct_inc, user_id))
    
    conn.commit()
    cursor.close()
    conn.close()


def get_stats(user_id):
    """Получает статистику из БД."""
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute(
        "SELECT cards_reviewed, correct_answers FROM learning_stats WHERE user_id = %s",
        (user_id,)
    )
    res = cursor.fetchone()
    cursor.close()
    conn.close()
    return res if res else (0, 0)


